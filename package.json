{
  "name": "key-generator",
  "displayName": "key-generator",
  "description": "Automatic key generator",
  "version": "1.0.0",
  "license": "MIT",
  "publisher": "aman-mahavar",
  "repository": {
    "type": "git",
    "url": "https://github.com/apthedeveloper/key-generator.git"
  },
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "key-generator.generateKey",
        "title": "ApDev: Generate Key"
      },
      {
        "command": "key-generator.copyKey",
        "title": "ApDev: Copy Key"
      },
      {
        "command": "key-generator.generateAndReplace",
        "title": "ApDev: Replace Key"
      }
    ]
  },
  "keybindings": [
    {
      "command": "key-generator.generateKey",
      "key": "ctrl+alt+g",
      "mac": "cmd+alt+g",
      "when": "editorTextFocus"
    },
    {
      "command": "key-generator.copyKey",
      "key": "ctrl+alt+c",
      "mac": "cmd+alt+c",
      "when": "editorTextFocus"
    },
    {
      "command": "key-generator.generateAndReplace",
      "key": "ctrl+alt+r",
      "mac": "cmd+alt+r",
      "when": "editorTextFocus"
    }
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
